{
	"name": "@narumitw/pi-codex-compact",
	"version": "0.52.0",
	"description": "Responses compaction protocols for compatible Pi providers.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"codex",
		"compaction",
		"openai"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md && npm run typecheck",
		"format": "biome check --write --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-agent-core": "0.84.4",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "26.4.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-codex-compact"
	}
}
