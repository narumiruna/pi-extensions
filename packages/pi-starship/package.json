{
	"name": "@narumitw/pi-starship",
	"version": "0.55.0",
	"description": "Native Starship-style TOML statusline and configuration skill for Pi.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"starship",
		"statusline",
		"footer",
		"toml",
		"agent-skill"
	],
	"files": [
		"src",
		"dist",
		"skills",
		"README.md",
		"LICENSE",
		"NOTICES.md"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts skills package.json tsconfig.json README.md NOTICES.md && npm run typecheck",
		"format": "biome check --write --vcs-use-ignore-file=false src test scripts skills package.json tsconfig.json README.md NOTICES.md",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0",
		"smol-toml": "^1.8.0",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@types/node": "26.4.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-starship"
	}
}
