{
  "name": "@narumitw/pi-starship",
  "version": "0.61.0",
  "description": "Native Starship-style TOML statusline and configuration skill for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "starship",
    "statusline",
    "footer",
    "toml",
    "agent-skill"
  ],
  "files": [
    "src",
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts skills package.json tsconfig.json README.md NOTICES.md && npm run typecheck",
    "format": "biome check --write --vcs-use-ignore-file=false src test scripts skills package.json tsconfig.json README.md NOTICES.md",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.66.0",
    "re2js": "^2.9.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-starship"
  }
}
