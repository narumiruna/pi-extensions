{
  "name": "@narumitw/pi-inspect",
  "version": "0.4.0",
  "description": "Read-only browser inspector for Pi session context and live tool calls.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "inspector",
    "context",
    "observability"
  ],
  "files": [
    "src",
    "dist",
    "browser-dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-runtime.mjs",
    "benchmark:first-use": "node scripts/benchmark-first-use.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && vitest run --config packages/pi-inspect/vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:git-install": "node scripts/git-install-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typebox": "1.4.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-inspect"
  }
}
