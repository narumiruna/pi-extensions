{
	"name": "@narumitw/pi-langfuse",
	"version": "0.50.5",
	"description": "Pi extension that traces LLM generations and tool activity to Langfuse.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"langfuse",
		"observability",
		"tracing"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"prepack": "npm run build",
		"check": "npm run build && biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@types/node": "26.4.0",
		"typescript": "7.0.2",
		"esbuild": "0.28.2"
	},
	"dependencies": {
		"@langfuse/otel": "^5.11.0",
		"@langfuse/tracing": "^5.11.0",
		"@narumitw/pi-tui-kit": "^0.59.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-langfuse"
	}
}
