{
	"name": "@narumitw/pi-statusline",
	"version": "0.49.14",
	"description": "Pi extension that replaces the footer with an information-rich statusline.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"statusline",
		"footer"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"piExtension": {
		"lifecycle": "stable"
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md && npm run typecheck",
		"format": "biome check --write --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@types/node": "26.2.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-statusline"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.58.1"
	}
}
