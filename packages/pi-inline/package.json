{
  "name": "@narumitw/pi-inline",
  "version": "0.5.0",
  "description": "Style inline badges and preview local file links in Pi's terminal UI.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "markdown",
    "wikilinks",
    "file-preview"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-inline"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.70.0",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.5"
  }
}
