{
	"name": "@narumitw/pi-usage",
	"version": "0.60.2",
	"description": "Pi extension that shows current-account usage and DeepSeek API balance for supported providers.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"usage",
		"quota",
		"balance",
		"deepseek",
		"fireworks",
		"baseten",
		"vercel-ai-gateway",
		"codex",
		"kimi",
		"kimi-coding",
		"moonshot",
		"moonshotai",
		"minimax",
		"token-plan",
		"copilot",
		"openrouter",
		"opencode",
		"zen",
		"zai",
		"glm",
		"xai",
		"grok"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md && npm run typecheck",
		"format": "biome check --write --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md",
		"typecheck": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-ai": "0.85.0",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@types/node": "26.4.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-usage"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0"
	}
}
