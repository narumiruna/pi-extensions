{
  "name": "@narumitw/pi-tui-kit",
  "version": "0.65.1",
  "description": "Declarative UI flows and navigation helpers built on Pi TUI.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "keywords": [
    "pi",
    "pi-extension",
    "tui",
    "menu",
    "library"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./confirmation": {
      "types": "./dist/confirmation.d.ts",
      "import": "./dist/confirmation.js"
    },
    "./custom-interaction": {
      "types": "./dist/custom-interaction.d.ts",
      "import": "./dist/custom-interaction.js"
    },
    "./document-review": {
      "types": "./dist/document-review.d.ts",
      "import": "./dist/document-review.js"
    },
    "./editor-status-widget": {
      "types": "./dist/editor-status-widget.d.ts",
      "import": "./dist/editor-status-widget.js"
    },
    "./interaction-hints": {
      "types": "./dist/interaction-hints.d.ts",
      "import": "./dist/interaction-hints.js"
    },
    "./live-choice": {
      "types": "./dist/live-choice.d.ts",
      "import": "./dist/live-choice.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./multi-select": {
      "types": "./dist/multi-select.d.ts",
      "import": "./dist/multi-select.js"
    },
    "./questionnaire": {
      "types": "./dist/questionnaire.d.ts",
      "import": "./dist/questionnaire.js"
    },
    "./selectors": {
      "types": "./dist/pi-selectors.d.ts",
      "import": "./dist/pi-selectors.js"
    },
    "./task": {
      "types": "./dist/task.d.ts",
      "import": "./dist/task.js"
    },
    "./terminal-document": {
      "types": "./dist/terminal-document.d.ts",
      "import": "./dist/terminal-document.js"
    },
    "./terminal-text": {
      "types": "./dist/terminal-text.d.ts",
      "import": "./dist/terminal-text.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "check": "biome check src test scripts package.json tsconfig.json tsconfig.build.json && npm run typecheck && npm run build",
    "format": "biome check --write src test scripts package.json tsconfig.json tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-tui-kit"
  },
  "dependencies": {
    "diff": "9.0.0",
    "grok-mermaid": "0.2.3",
    "highlight.js": "11.12.0"
  }
}
