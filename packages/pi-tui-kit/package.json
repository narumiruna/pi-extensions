{
	"name": "@narumitw/pi-tui-kit",
	"version": "0.58.1",
	"description": "Declarative UI flows and navigation helpers built on Pi TUI.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"sideEffects": false,
	"keywords": [
		"pi",
		"pi-extension",
		"tui",
		"menu",
		"library"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./interaction-hints": {
			"types": "./dist/interaction-hints.d.ts",
			"import": "./dist/interaction-hints.js"
		},
		"./terminal-text": {
			"types": "./dist/terminal-text.d.ts",
			"import": "./dist/terminal-text.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"prepack": "npm run build",
		"check": "biome check src test scripts package.json tsconfig.json tsconfig.build.json && npm run typecheck && npm run build",
		"format": "biome check --write src test scripts package.json tsconfig.json tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-tui-kit"
	},
	"dependencies": {
		"grok-mermaid": "0.2.3",
		"highlight.js": "11.12.0"
	}
}
