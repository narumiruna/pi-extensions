{
  "name": "@narumitw/pi-chrome-devtools",
  "version": "0.54.1",
  "description": "Pi extension that exposes Chrome DevTools Protocol tools.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "chrome",
    "devtools",
    "cdp",
    "webmcp"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "esbuild": "0.28.2",
    "typebox": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.70.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-chrome-devtools"
  }
}
