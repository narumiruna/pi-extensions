{
  "name": "@narumitw/pi-linux-voice",
  "version": "0.1.0",
  "description": "Pi extension for Linux voice input using ffmpeg and Groq transcription",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "voice",
    "speech-to-text",
    "groq",
    "linux"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-linux-voice"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
