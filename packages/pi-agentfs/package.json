{
  "name": "@narumitw/pi-agentfs",
  "version": "0.2.3",
  "description": "AgentFS virtual file workspace and restricted just-bash tools for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agentfs",
    "workspace",
    "just-bash"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.68.0",
    "@tursodatabase/database": "0.8.3",
    "agentfs-sdk": "0.6.4",
    "just-bash": "3.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-agentfs"
  }
}
