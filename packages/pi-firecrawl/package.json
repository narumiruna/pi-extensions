{
  "name": "@narumitw/pi-firecrawl",
  "version": "0.51.1",
  "description": "Pi extension that exposes Firecrawl web scraping and crawling tools.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "firecrawl",
    "scrape",
    "crawl"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "esbuild": "0.28.2",
    "typebox": "1.4.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.70.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-firecrawl"
  }
}
