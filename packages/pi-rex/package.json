{
  "name": "@narumitw/pi-rex",
  "version": "0.1.0",
  "description": "Show Pi sessions in Rex above the editor and switch to their terminal panes.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "rex",
    "sessions",
    "status",
    "widget"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.70.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-rex"
  }
}
