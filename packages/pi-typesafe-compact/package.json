{
  "name": "@narumitw/pi-typesafe-compact",
  "version": "0.1.1",
  "description": "TypeSafe JEV-guided selective history compaction for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "jev",
    "typesafe-ai",
    "compaction",
    "context-window"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.65.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-typesafe-compact"
  }
}
