{
  "name": "@narumitw/pi-sync-daemon",
  "version": "0.7.0",
  "description": "A local synchronization daemon with a versioned client API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine/*": {
      "types": "./dist/engine/*.d.ts",
      "default": "./dist/engine/*.js"
    }
  },
  "bin": {
    "pi-sync-daemon": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "fast-xml-parser": "^5.12.1",
    "minimatch": "^11.0.9",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-sync-daemon"
  }
}
