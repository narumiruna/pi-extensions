{
	"name": "@narumitw/pi-chat",
	"version": "0.1.6",
	"description": "Peer-to-peer chat extension for Pi.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"chat",
		"p2p",
		"dht"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check . && npm run typecheck",
		"format": "biome check --write .",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0",
		"hyperdht": "6.33.2",
		"hyperswarm": "4.17.0",
		"sodium-universal": "5.0.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@types/node": "26.4.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-chat"
	}
}
