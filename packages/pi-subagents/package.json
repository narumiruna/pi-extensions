{
  "name": "@narumitw/pi-subagents",
  "version": "3.1.0",
  "description": "Subagent jobs with asynchronous main-agent messaging for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "subagents",
    "agents",
    "delegation"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-subagents"
  },
  "dependencies": {
    "ignore": "^7.0.8"
  }
}
